NODE_ENV=development
PORT=3005

# MongoDB — required in production. In development an in-memory database is used
# when this is empty. Production refuses to start without a real URI.
MONGODB_URI=mongodb://localhost:27017/ticketr_db

# Security & JWT — must be unique and at least 32 characters in production.
JWT_SECRET=replace_with_a_unique_secret_of_at_least_32_characters
JWT_EXPIRATION=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxx

# Resend (email delivery). Mock mode is refused in production.
RESEND_API_KEY=re_xxxxxx
RESEND_FROM_EMAIL=Ticketr <tickets@ticketr.org>

# Cloudinary (event covers, ticket artwork, payment receipts)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Application URLs (used for wallet links, reset links and CORS)
FRONTEND_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
SUPER_ADMIN_URL=http://localhost:3001
# Optional explicit CORS allowlist (comma separated). Defaults to the URLs above.
CORS_ORIGINS=

# Optional: extra hosts allowed for ticket artwork downloads (SSRF allowlist)
ALLOWED_TEMPLATE_HOSTS=

# Redis — optional. Used for the gate-scan cache and cron locks. Mongo remains
# the source of truth for inventory and check-in.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional
SENTRY_DSN=
